# Variables públicas necesarias para que el navegador se conecte a Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Mantiene ocultos/bloqueados los módulos pendientes en la primera entrega.
# Para reactivar todo el proyecto en una etapa futura: APP_COMMERCIAL_ONLY=false
APP_COMMERCIAL_ONLY=true

# Solo si posteriormente publicas procesos de servidor que usan service_role.
# NO uses prefijo NEXT_PUBLIC para esta clave.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
